{
	"name": "Linq inbound AI reply (review example)",
	"active": false,
	"nodes": [
		{
			"id": "linq-trigger",
			"name": "Linq Trigger",
			"type": "@linqapp/n8n-nodes-linq.linqTrigger",
			"typeVersion": 1,
			"position": [0, 0],
			"parameters": {}
		},
		{
			"id": "direct-text",
			"name": "Direct text only",
			"type": "n8n-nodes-base.if",
			"typeVersion": 2.2,
			"position": [220, 0],
			"parameters": {
				"conditions": {
					"options": {
						"caseSensitive": true,
						"typeValidation": "strict"
					},
					"conditions": [
						{
							"id": "is-direct",
							"leftValue": "={{ $json.event.data.chat.is_group === false }}",
							"rightValue": false,
							"operator": {
								"type": "boolean",
								"operation": "true",
								"singleValue": true
							}
						},
						{
							"id": "has-text",
							"leftValue": "={{ $json.text }}",
							"rightValue": "",
							"operator": {
								"type": "string",
								"operation": "notEmpty",
								"singleValue": true
							}
						}
					],
					"combinator": "and"
				},
				"options": {}
			}
		},
		{
			"id": "chain",
			"name": "Generate Reply",
			"type": "@n8n/n8n-nodes-langchain.chainLlm",
			"typeVersion": 1.7,
			"position": [450, 0],
			"parameters": {
				"promptType": "define",
				"text": "={{ $json.text }}"
			}
		},
		{
			"id": "model",
			"name": "OpenAI Chat Model",
			"type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
			"typeVersion": 1.2,
			"position": [450, 220],
			"parameters": {
				"model": {
					"__rl": true,
					"mode": "list",
					"value": "gpt-4o-mini"
				},
				"options": {}
			}
		},
		{
			"id": "reply",
			"name": "Reply in original chat",
			"type": "@linqapp/n8n-nodes-linq.linq",
			"typeVersion": 1,
			"position": [700, 0],
			"parameters": {
				"operation": "reply",
				"chatId": "={{ $('Linq Trigger').item.json.chatId }}",
				"text": "={{ $json.text }}",
				"idempotencyKey": "={{ $('Linq Trigger').item.json.eventId + ':ai-reply' }}"
			},
			"retryOnFail": false
		}
	],
	"connections": {
		"Linq Trigger": {
			"main": [
				[
					{
						"node": "Direct text only",
						"type": "main",
						"index": 0
					}
				]
			]
		},
		"Direct text only": {
			"main": [
				[
					{
						"node": "Generate Reply",
						"type": "main",
						"index": 0
					}
				],
				[]
			]
		},
		"OpenAI Chat Model": {
			"ai_languageModel": [
				[
					{
						"node": "Generate Reply",
						"type": "ai_languageModel",
						"index": 0
					}
				]
			]
		},
		"Generate Reply": {
			"main": [
				[
					{
						"node": "Reply in original chat",
						"type": "main",
						"index": 0
					}
				]
			]
		}
	},
	"settings": {
		"executionOrder": "v1"
	}
}
